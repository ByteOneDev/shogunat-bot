# Copie ce fichier en .env et remplis-le. Ne partage JAMAIS le fichier .env.

# --- Discord (https://discord.com/developers/applications → ton application) ---
# Onglet Bot → Reset Token
DISCORD_TOKEN=
# Onglet OAuth2 → Client ID et Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Clic droit sur ton serveur Discord → Copier l'identifiant (mode développeur activé)
GUILD_ID=
# Facultatif : rôle Discord qui a accès au panneau (sinon : rôle « Staff Shogunat » créé par le bot,
# et toujours les membres qui ont la permission « Gérer le serveur »)
ADMIN_ROLE_ID=

# --- Panneau web ---
# PANEL=off : seul le bot tourne, sans panneau (hébergeur qui n'ouvre aucun port public). Le bot fonctionne très bien seul.
# PANEL=on  : bot + panneau (par défaut).
PANEL=on
# Adresse publique du panneau (doit aussi être ajoutée dans OAuth2 → Redirects : <PUBLIC_URL>/callback)
PUBLIC_URL=http://localhost:8080
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Longue chaîne aléatoire : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Adresse du site public (pour l'objectif mensuel réglé depuis le panneau). Change-la si tu utilises un nom de domaine.
SITE_ORIGIN=https://byteonedev.github.io

# --- Boutique (/boutique) ---
# BOUTIQUE=on pour l'activer. Elle a besoin d'une adresse HTTPS publique (PUBLIC_URL) pour les vrais paiements.
BOUTIQUE=off
# Stripe (dashboard.stripe.com → Développeurs → Clés API). Commence par les clés de TEST (sk_test_...).
STRIPE_SECRET_KEY=
# Stripe → Développeurs → Webhooks → point de terminaison <PUBLIC_URL>/boutique/stripe/webhook → secret de signature (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Application Azure (portal.azure.com → Inscriptions d'applications), comptes Microsoft personnels,
# URI de redirection <PUBLIC_URL>/boutique/connexion/retour. Doit être validée par Mojang pour l'API Minecraft.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 1 seulement derrière un proxy (Caddy, Cloudflare…) qui fournit la vraie IP dans X-Forwarded-For
TRUST_PROXY=

# --- Serveur Minecraft ---
MC_ADRESSE=91.197.6.134:22112
# RCON (server.properties : enable-rcon=true, rcon.password, rcon.port = port public ajouté chez MineStrator)
RCON_HOST=91.197.6.134
RCON_PORT=
RCON_PASSWORD=
