[Unit]
Description=Bot Discord et panneau du Shogunat
After=network-online.target
Wants=network-online.target

[Service]
User=shogunat
WorkingDirectory=/opt/shogunat-bot
ExecStart=/opt/shogunat-bot/.venv/bin/python run.py
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/shogunat-bot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
